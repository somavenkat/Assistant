# Server
PORT=3001

# OpenAI (order parsing + restaurant lookup)
OPENAI_API_KEY=sk-...

# Twilio (imported into Vapi for outbound calls)
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Vapi.ai voice agent
# Private key from https://dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=your_vapi_private_key
VAPI_ASSISTANT_ID=af5317c9-ccb6-44ca-adcc-e462d208d5b1
# Optional: set after first import, or leave blank to auto-import Twilio number
VAPI_PHONE_NUMBER_ID=
# Outbound voice — Vapi Sagar v2 (Indian American accent, low latency, no ElevenLabs glitches)
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Sagar
# Optional ElevenLabs (only if VAPI_VOICE_PROVIDER=11labs)
ELEVENLABS_API_KEY=
ELEVENLABS_CREDENTIAL_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
VAPI_VOICE_FALLBACK=vapi
VAPI_VOICE_FALLBACK_ID=Sagar
# Live call + spoken-brief planner (natural speech). Lookups stay on gpt-4o-mini.
VAPI_LLM_MODEL=gpt-4.1
OPENAI_PLAN_MODEL=gpt-4.1
OPENAI_CHEAP_MODEL=gpt-4o-mini

# Optional: Google Places (better restaurant phone lookup). If empty, OpenAI web search is used.
GOOGLE_PLACES_API_KEY=

# Optional: explicit webhook base URL (defaults to Vercel production URL)
PUBLIC_APP_URL=https://assistant-six-omega.vercel.app

# Shared mission + chat storage.
# REQUIRED in production: Vercel runs many function instances and each gets its own /tmp,
# so without shared storage a mission created by one instance 404s ("Mission not found")
# on the next. Local dev falls back to backend/data/*.json and needs neither.
#
# Vercel Blob (current) — injected automatically by `vercel blob create-store`.
BLOB_READ_WRITE_TOKEN=
# Upstash for Redis (optional, takes priority over Blob — faster for frequent writes).
KV_REST_API_URL=
KV_REST_API_TOKEN=

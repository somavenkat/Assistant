# Server
PORT=3001

# OpenAI (order parsing + restaurant lookup)
OPENAI_API_KEY=sk-...

# Twilio (imported into Vapi for outbound calls)
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Vapi.ai voice agent
# Private key from https://dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=your_vapi_private_key
VAPI_ASSISTANT_ID=af5317c9-ccb6-44ca-adcc-e462d208d5b1
# Optional: set after first import, or leave blank to auto-import Twilio number
VAPI_PHONE_NUMBER_ID=

# Optional: Google Places (better restaurant phone lookup). If empty, OpenAI web search is used.
GOOGLE_PLACES_API_KEY=